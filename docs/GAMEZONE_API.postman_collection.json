{
  "info": {
    "name": "GAMEZONE API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden: las primeras peticiones guardan tokens e ids en variables."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "token_jugador",
      "value": ""
    },
    {
      "key": "torneo_id",
      "value": ""
    },
    {
      "key": "videojuego_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Token admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/token/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin_demo\",\n  \"password\": \"Gamezone2026!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token_admin', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Token jugador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/token/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"neonviper\",\n  \"password\": \"Gamezone2026!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token_jugador', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar torneos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token_jugador}}"
          }
        ],
        "url": "{{base_url}}/torneos/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('videojuego_id', pm.response.json()[0].videojuego);"
            ]
          }
        }
      ]
    },
    {
      "name": "Filtrar torneos disponibles",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token_jugador}}"
          }
        ],
        "url": "{{base_url}}/torneos/?estado=DISPONIBLE&min_inscritos=1"
      }
    },
    {
      "name": "Crear torneo (admin, 201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token_admin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/torneos/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Torneo creado desde Postman\",\n  \"videojuego\": {{videojuego_id}},\n  \"fecha\": \"2026-12-15T19:00:00-03:00\",\n  \"max_participantes\": 8,\n  \"descripcion\": \"Creado vía API\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('torneo_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Detalle de torneo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token_jugador}}"
          }
        ],
        "url": "{{base_url}}/torneos/{{torneo_id}}/"
      }
    },
    {
      "name": "Actualizar torneo (admin)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token_admin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/torneos/{{torneo_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"max_participantes\": 16,\n  \"estado\": \"DISPONIBLE\"\n}"
        }
      }
    },
    {
      "name": "Datos inválidos (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token_admin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/torneos/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"abc\",\n  \"videojuego\": {{videojuego_id}},\n  \"fecha\": \"2020-01-01T10:00:00Z\",\n  \"max_participantes\": 500,\n  \"descripcion\": \"Creado vía API\"\n}"
        }
      }
    },
    {
      "name": "Inscribirse (jugador, 201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token_jugador}}"
          }
        ],
        "url": "{{base_url}}/torneos/{{torneo_id}}/inscribirse/"
      }
    },
    {
      "name": "Inscribirse otra vez (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token_jugador}}"
          }
        ],
        "url": "{{base_url}}/torneos/{{torneo_id}}/inscribirse/"
      }
    },
    {
      "name": "Jugador intenta crear (403)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token_jugador}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/torneos/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Torneo creado desde Postman\",\n  \"videojuego\": {{videojuego_id}},\n  \"fecha\": \"2026-12-15T19:00:00-03:00\",\n  \"max_participantes\": 8,\n  \"descripcion\": \"Creado vía API\"\n}"
        }
      }
    },
    {
      "name": "Sin token (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/torneos/"
      }
    },
    {
      "name": "Torneo inexistente (404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token_jugador}}"
          }
        ],
        "url": "{{base_url}}/torneos/99999/"
      }
    },
    {
      "name": "Eliminar torneo (admin, 204)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/torneos/{{torneo_id}}/"
      }
    }
  ]
}
