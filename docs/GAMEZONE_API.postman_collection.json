{
  "info": {
    "name": "GAMEZONE API",
    "description": "API REST de la Plataforma de Torneos Gamer GAMEZONE (Django REST Framework).\n\nOrden sugerido: ejecutar primero las dos peticiones de '1. Autenticación'; guardan los tokens en las variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "token_jugador",
      "value": ""
    },
    {
      "key": "torneo_id",
      "value": "1"
    },
    {
      "key": "videojuego_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Obtener token (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_admin', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_demo\",\n  \"password\": \"Gamezone2026!\"\n}"
            },
            "url": "{{base_url}}/token/"
          }
        },
        {
          "name": "Obtener token (jugador)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_jugador', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"neonviper\",\n  \"password\": \"Gamezone2026!\"\n}"
            },
            "url": "{{base_url}}/token/"
          }
        },
        {
          "name": "Obtener un videojuego (guarda su id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('videojuego_id', pm.response.json().results[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_admin}}"
              }
            ],
            "url": "{{base_url}}/videojuegos/"
          }
        },
        {
          "name": "Credenciales inválidas (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_demo\",\n  \"password\": \"incorrecta\"\n}"
            },
            "url": "{{base_url}}/token/"
          }
        }
      ]
    },
    {
      "name": "2. Torneos (lectura)",
      "item": [
        {
          "name": "Listar torneos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              }
            ],
            "url": "{{base_url}}/torneos/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('torneo_id', pm.response.json().results[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar: disponibles, más inscritos primero",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/torneos/?estado=DISPONIBLE&orden=-num_inscritos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "torneos",
                ""
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "DISPONIBLE"
                },
                {
                  "key": "orden",
                  "value": "-num_inscritos"
                }
              ]
            }
          }
        },
        {
          "name": "Filtrar: por fecha y mínimo de inscritos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/torneos/?fecha_desde=2026-01-01&min_inscritos=3",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "torneos",
                ""
              ],
              "query": [
                {
                  "key": "fecha_desde",
                  "value": "2026-01-01"
                },
                {
                  "key": "min_inscritos",
                  "value": "3"
                }
              ]
            }
          }
        },
        {
          "name": "Detalle de torneo (con inscritos)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              }
            ],
            "url": "{{base_url}}/torneos/{{torneo_id}}/"
          }
        },
        {
          "name": "Inscritos de un torneo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              }
            ],
            "url": "{{base_url}}/torneos/{{torneo_id}}/inscritos/"
          }
        },
        {
          "name": "Videojuegos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              }
            ],
            "url": "{{base_url}}/videojuegos/"
          }
        }
      ]
    },
    {
      "name": "3. Torneos (administrador)",
      "item": [
        {
          "name": "Crear torneo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('torneo_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_admin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Torneo creado desde Postman\",\n  \"videojuego\": {{videojuego_id}},\n  \"fecha\": \"2026-12-15T19:00:00-03:00\",\n  \"max_participantes\": 8,\n  \"descripcion\": \"Creado vía API REST\"\n}"
            },
            "url": "{{base_url}}/torneos/"
          }
        },
        {
          "name": "Actualizar torneo (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_admin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"Descripción actualizada\",\n  \"max_participantes\": 16\n}"
            },
            "url": "{{base_url}}/torneos/{{torneo_id}}/"
          }
        },
        {
          "name": "Validación: datos inválidos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_admin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"abc\",\n  \"videojuego\": {{videojuego_id}},\n  \"fecha\": \"2020-01-01T10:00:00Z\",\n  \"max_participantes\": 500\n}"
            },
            "url": "{{base_url}}/torneos/"
          }
        },
        {
          "name": "Validación: pasar a En Curso sin jugadores (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_admin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EN_CURSO\"\n}"
            },
            "url": "{{base_url}}/torneos/{{torneo_id}}/"
          }
        },
        {
          "name": "Informes y métricas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_admin}}"
              }
            ],
            "url": "{{base_url}}/informes/"
          }
        }
      ]
    },
    {
      "name": "4. Inscripciones (jugador)",
      "item": [
        {
          "name": "Inscribirse en el torneo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              }
            ],
            "url": "{{base_url}}/torneos/{{torneo_id}}/inscripcion/"
          }
        },
        {
          "name": "Inscribirse otra vez (400: ya inscrito)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              }
            ],
            "url": "{{base_url}}/torneos/{{torneo_id}}/inscripcion/"
          }
        },
        {
          "name": "Mis inscripciones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              }
            ],
            "url": "{{base_url}}/inscripciones/"
          }
        },
        {
          "name": "Cancelar inscripción",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              }
            ],
            "url": "{{base_url}}/torneos/{{torneo_id}}/inscripcion/"
          }
        }
      ]
    },
    {
      "name": "5. Seguridad y errores",
      "item": [
        {
          "name": "Sin token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/torneos/"
          }
        },
        {
          "name": "Jugador intenta crear torneo (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Intento no autorizado\",\n  \"videojuego\": {{videojuego_id}},\n  \"fecha\": \"2026-12-20T19:00:00-03:00\",\n  \"max_participantes\": 8\n}"
            },
            "url": "{{base_url}}/torneos/"
          }
        },
        {
          "name": "Jugador pide informes (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              }
            ],
            "url": "{{base_url}}/informes/"
          }
        },
        {
          "name": "Torneo inexistente (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_jugador}}"
              }
            ],
            "url": "{{base_url}}/torneos/99999/"
          }
        },
        {
          "name": "Eliminar torneo (admin, 204)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token_admin}}"
              }
            ],
            "url": "{{base_url}}/torneos/{{torneo_id}}/"
          }
        }
      ]
    }
  ]
}
